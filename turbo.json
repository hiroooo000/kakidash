{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "index.html",
        "package.json",
        "tsconfig.json",
        "vite.config.ts"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        "lint",
        "typecheck",
        "format",
        "dep:check"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "test"
      ],
      "inputs": [
        "src/**",
        "tests/e2e/**",
        "playwright.config.ts",
        "package.json",
        "tsconfig.json"
      ]
    },
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        "eslint.config.js",
        "tsconfig.json"
      ]
    },
    "docs": {
      "inputs": [
        "src/**",
        "package.json",
        "typedoc.json",
        "tsconfig.json"
      ],
      "outputs": [
        "docs/api/**"
      ]
    },
    "format": {
      "inputs": [
        "src/**",
        "tests/**",
        "package.json",
        ".prettierrc"
      ]
    },
    "dep:check": {
      "inputs": [
        "src/**",
        ".dependency-cruiser.cjs",
        "package.json",
        "tsconfig.json"
      ]
    }
  }
}