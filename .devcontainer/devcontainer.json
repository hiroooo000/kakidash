{
  "name": "kakidash",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true,
      "installJupyter": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "pnpm": "latest"
    }
  },
  "mounts": [
    "source=kakidash-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=kakidash-pnpm-store,target=${containerWorkspaceFolder}/.pnpm-store,type=volume",
    "source=kakidash-turbo-cache,target=${containerWorkspaceFolder}/.turbo,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        }
      }
    }
  },
  "containerEnv": {
    "TZ": "Asia/Tokyo",
    "PLAYWRIGHT_BROWSERS_PATH": "0"
  },
  "remoteUser": "node",
  "privileged": true,
  "postCreateCommand": ".devcontainer/postCreateCommand.sh | tee .devcontainer/postCreateCommand.log"
}